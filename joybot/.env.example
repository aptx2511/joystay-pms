# ── Bắt buộc ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PUBLIC_URL=https://<ten-service-joybot>.up.railway.app
ADMIN_KEY=                      # chuỗi bí mật tự đặt, dùng để test /chat

PMS_BASE_URL=https://joystay-pms.vercel.app/api
PMS_CRON_SECRET=                # = CRON_SECRET bên PMS (Vercel) — để đồng bộ lịch OTA mỗi 15 phút
PMS_API_KEY=                    # = PMS_API_KEY bên PMS (Vercel) — bắt buộc khi PMS bật khoá đăng nhập

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Bảng phòng + giá đặt trực tiếp (JSON 1 dòng) — xem docs/BOOKING_BOT_SETUP.md
ROOMS_JSON=

# ── Thanh toán ───────────────────────────────────────────
DEPOSIT_PERCENT=50
HOLD_MINUTES=30
BANK_ID=                        # mã ngân hàng VietQR, vd VCB / TCB / MB / ACB
BANK_ACCOUNT_NO=                # CHỦ TỰ ĐIỀN
BANK_ACCOUNT_NAME=              # tên chủ TK, không dấu
WEEKLY_DISCOUNT_PCT=10
MONTHLY_DISCOUNT_PCT=29
CHECKIN_TIME=15:00
CHECKOUT_TIME=12:00

# ── Telegram (bot RIÊNG cho JoyBot) ─────────────────────
JOYBOT_TELEGRAM_TOKEN=
JOYBOT_TELEGRAM_CHAT_ID=
JOYBOT_TELEGRAM_WEBHOOK_SECRET= # chuỗi bí mật tự đặt

# ── Meta: Messenger + Instagram + WhatsApp ──────────────
META_VERIFY_TOKEN=              # chuỗi tự đặt, nhập giống hệt trên Meta
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Zalo OA ─────────────────────────────────────────────
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=

# ── Giai đoạn B: xác nhận tiền tự động ──────────────────
SEPAY_API_KEY=                  # để trống = chưa bật
AUTO_CONFIRM_ON_PAYMENT=true

# ── Khoá cửa TTLock (EU) — CHỦ TỰ ĐIỀN ─────────────────
TTLOCK_BASE_URL=https://euapi.ttlock.com
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=                # tài khoản app TTLock quản lý các khoá
TTLOCK_PASSWORD=
# ROOM_LOCKS_JSON={"101":29770292,"201":29651740,"202":18005596,"301":35796696,"302":29770114,"401":29770358}
# ENTRANCE_LOCKS_JSON=[{"name":"Cửa nhà","lockId":29769774},{"name":"Cổng (mặt trong)","lockId":29747718}]
# ROOMS_JSON: thêm "roomNo" cho mỗi phòng (vd "roomNo":"302") để bot biết dùng khoá nào

# ── Lịch dọn phòng (Ops 2.0) — gửi Telegram theo giờ VN ─────────
# HK_WEEKLY_DAY=0                # 0 = Chủ nhật
# HK_WEEKLY_TIME=20:00
# HK_DAILY_TIME=07:30
# HK_ALERT_TIME=14:30
# ── Cổng khách (Ops 2.0) ───────────────────────────────────────
# STAY_DIGEST_TIMES=07:30,20:00   # giờ gửi bản tin khách đến hôm nay

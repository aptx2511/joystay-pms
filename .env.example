DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cron: Vercel 08:00 + JoyBot gọi /api/ical/sync mỗi 15 phút (Authorization: Bearer CRON_SECRET)
CRON_SECRET=

# ── Bảo mật (Ops 2.0) ─────────────────────────────────────────────
# Đặt PMS_ADMIN_PASSWORD là BẬT khoá đăng nhập cho toàn bộ PMS (trừ iCal, phòng trống, trang lao công).
# Bật SAU KHI website + JoyBot đã có PMS_API_KEY, nếu không web sẽ không tạo được booking.
PMS_ADMIN_USER=admin
PMS_ADMIN_PASSWORD=
# Khoá cho máy chủ gọi PMS (website /api/book, JoyBot) — header x-api-key
PMS_API_KEY=

# ── Dọn phòng (Ops 2.0 — Module 1) ────────────────────────────────
# Link gửi lao công dùng địa chỉ này
PMS_PUBLIC_URL=https://joystay-pms.vercel.app
# Kho ảnh: Vercel Dashboard → joystay-pms → Storage → Create/Connect Blob store → tự thêm biến này
BLOB_READ_WRITE_TOKEN=
# Báo chủ khi lao công nộp việc (dùng CHUNG bot Telegram với JoyBot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cổng khách (Ops 2.0 — Module 3) ───────────────────────────────
# WiFi hiện cùng mã cửa trên cổng khách (KHÔNG đưa lên website công khai)
STAY_WIFI_NAME=Joystay
STAY_WIFI_PASSWORD=
# Tuỳ chọn (đã có mặc định):
# STAY_CHECKIN_TIME=15:00
# STAY_CHECKOUT_TIME=12:00
# STAY_CODES_OPEN_TIME=10:00     # giờ mã cửa bắt đầu hiện
# STAY_CODES_OPEN_DAYS_BEFORE=1  # hiện trước ngày nhận phòng bao nhiêu ngày (0 = đúng ngày)
# STAY_REQUIRE_ID=true           # false = hiện mã kể cả khi khách chưa gửi giấy tờ
# STAY_ID_RETENTION_DAYS=30      # tự xoá ảnh giấy tờ sau N ngày kể từ trả phòng
# STAY_HOTLINE=+84 854 777 730
# STAY_WHATSAPP=https://wa.me/84854777730
# STAY_GOOGLE_REVIEW_URL=https://g.page/r/CdJ1fHrqKevREAE/review

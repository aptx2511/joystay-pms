generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id            String    @id @default(cuid())
  name          String    @unique
  size          Int       // square meters
  pricePerNight        Float?    // weekday rate (Sun–Thu, VND)
  weekendPricePerNight Float?    // weekend rate (Fri–Sat, VND) — null = same as weekday
  icalUrl          String?   // Airbnb iCal URL for importing
  bookingIcalUrl   String?   // Booking.com iCal URL
  agodaIcalUrl     String?   // Agoda iCal URL
  travelokaIcalUrl String?   // Traveloka iCal URL
  airbnbIcalUrl2   String?   // Second Airbnb listing on the same physical room (e.g. 302 Parisian + B&W)
  roomNumber       String?   // Physical room number, e.g. "302"
  weeklyDiscount   Float?    // % length-of-stay discount on Airbnb for >= 7 nights
  monthlyDiscount  Float?    // % length-of-stay discount on Airbnb for >= 28 nights
  sortOrder        Int       @default(0)
  createdAt     DateTime  @default(now())
  bookings      Booking[]
  cleaningTasks CleaningTask[]
  rates         RoomRate[]
  txns          Txn[]
  fixedCosts    FixedCost[]
}

// ── Housekeeping (Ops 2.0 — Module 1) ─────────────────────────────────────────
model Cleaner {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  // INTERNAL (lao công quen) | APP (Jupviec / bTaskee / freelancer)
  type        String   @default("INTERNAL")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  tasks       CleaningTask[]
}

model CleaningTask {
  id            String    @id @default(cuid())
  roomId        String
  date          DateTime  // ngày dọn (UTC midnight của ngày theo giờ VN)
  // TURNOVER (sau trả phòng) | MIDSTAY (dọn giữa kỳ) | DEEP (tổng vệ sinh / côn trùng)
  type          String    @default("TURNOVER")
  // TODO | ASSIGNED | IN_PROGRESS | DONE (chờ duyệt) | APPROVED | REJECTED (làm lại) | SKIPPED
  status        String    @default("TODO")
  // URGENT = có khách nhận phòng cùng ngày
  priority      String    @default("NORMAL")
  windowStart   String    @default("12:00")
  windowEnd     String    @default("15:00")
  bookingOutId  String?
  bookingInId   String?
  guestOut      String?
  guestIn       String?
  cleanerId     String?
  token         String    @unique   // khoá bí mật trong link gửi lao công
  checklist     Json?               // [{ key, label, hint, done, photos: string[] }]
  issueNote     String?             // hư hỏng / đồ khách để quên
  issuePhotos   Json?               // string[]
  hasIssue      Boolean   @default(false)
  autoGenerated Boolean   @default(true)
  note          String?
  rejectReason  String?
  startedAt     DateTime?
  doneAt        DateTime?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  room    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  cleaner Cleaner? @relation(fields: [cleanerId], references: [id], onDelete: SetNull)

  @@unique([roomId, date, type])
  @@index([date])
}

model Guest {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Booking {
  id         String   @id @default(cuid())
  roomId     String
  guestId    String?
  // Denormalized guest name for quick display (avoids join when guestId is null)
  guestName  String
  checkIn    DateTime
  checkOut   DateTime
  // DIRECT | AIRBNB | BOOKING | AGODA | TRAVELOKA | OFFLINE
  source     String   @default("DIRECT")
  // CONFIRMED | PENDING | CANCELLED | BLOCKED (calendar block, not a stay)
  status     String   @default("CONFIRMED")
  totalPrice   Float?
  notes        String?
  // CCCD images for temporary residence registration
  cccdFrontUrl String?
  cccdBackUrl  String?
  // External reference (e.g. Airbnb confirmation code or iCal UID)
  externalId   String?
  // AUTO (calculated from room rates) | MANUAL (edited by host) | IMPORT (from OTA payout CSV)
  priceSource      String    @default("AUTO")
  confirmationCode String?   // OTA confirmation code (Airbnb HMXXXX, Booking number...)
  feedKey          String?   // which iCal field imported this booking (icalUrl, airbnbIcalUrl2, ...)
  cancelledAt      DateTime? // set when the booking disappeared from the OTA feed
  lastSyncedAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guest Guest? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  portal StayPortal?

  // Prevent duplicate iCal imports for the same room
  @@unique([roomId, externalId])
  @@index([checkIn])
  @@index([checkOut])
  @@index([roomId])
}

model Shift {
  id        String   @id @default(cuid())
  workDate  DateTime // UTC midnight of the work day
  hours     Int      @default(1) // hours worked: 1 or 2
  note      String?
  createdAt DateTime @default(now())

  @@unique([workDate])
}

// ── Cổng khách (Ops 2.0 — Module 3) ───────────────────────────────────────────
model StayPortal {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  token         String    @unique   // link riêng của khách: /s/<token>
  phoneLast4    String?             // 4 số cuối ĐT (Airbnb iCal) — để khách tự tra cứu
  lang          String    @default("en")
  guests        Int?
  arrivalTime   String?             // giờ khách dự kiến đến
  idPhotos      Json?               // string[] ảnh hộ chiếu / CCCD (xoá sau 30 ngày kể từ trả phòng)
  idSubmittedAt DateTime?
  doorCodes     Json?               // [{ door, code }]
  codesSource   String?             // TTLOCK | MANUAL
  codesIssuedAt DateTime?
  firstViewAt   DateTime?
  codesViewedAt DateTime?
  registeredAt  DateTime?           // chủ đã khai báo lưu trú
  issues        Json?               // [{ at, text }]
  feedback      Json?               // { rating, text, at }
  idPurgedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}


/// Giá theo ngày (Ops 2.0 — Giá & phòng trống). Đêm = date (UTC 00:00 của ngày VN).
model RoomRate {
  id           String    @id @default(cuid())
  roomId       String
  date         DateTime
  price        Float?    // giá áp dụng cho kênh trực tiếp (website, JoyBot) — null = dùng giá gốc phòng
  airbnbPrice  Float?    // giá đang đặt trên Airbnb (đọc về từ lịch Airbnb)
  airbnbTip    Float?    // "Gợi ý giá" của Airbnb cho đêm này
  tipAt        DateTime? // lúc đọc gợi ý Airbnb
  airbnbTarget Float?    // giá cần đặt trên Airbnb (sau khi bấm Áp dụng)
  airbnbDoneAt DateTime? // chủ đã chỉnh xong trên Airbnb
  appliedAt    DateTime?
  source       String?   // RULE | AIRBNB_TIP | MANUAL
  updatedAt    DateTime  @updatedAt
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([date])
}


/// Thu chi (Ops — Tài chính). kind IN = tiền vào, OUT = chi ra. roomId null = chi phí chung.
model Txn {
  id        String   @id @default(cuid())
  kind      String   // IN | OUT
  date      DateTime // ngày phát sinh (UTC 00:00 ngày VN)
  amount    Float    // luôn dương
  category  String
  roomId    String?
  bookingId String?  // tiền về của booking nào (đối soát)
  channel   String?  // AIRBNB | BOOKING | AGODA | DIRECT | CASH | TRANSFER
  note      String?
  source    String   @default("MANUAL") // MANUAL | CSV
  ref       String?  // khoá chống nhập trùng khi import CSV
  createdAt DateTime @default(now())

  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([source, ref])
  @@index([date])
  @@index([bookingId])
}

/// Chi phí cố định hằng tháng (tiền nhà, internet…) — tự cộng vào mỗi tháng từ startMonth
model FixedCost {
  id         String   @id @default(cuid())
  name       String
  amount     Float
  category   String
  roomId     String?
  startMonth String   // YYYY-MM
  endMonth   String?  // YYYY-MM (null = vẫn đang áp dụng)
  createdAt  DateTime @default(now())

  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
}

// Cảnh báo đồng bộ lịch đã gửi Telegram (chống gửi lặp mỗi 15 phút)
model SyncAlert {
  key    String   @id
  sentAt DateTime @default(now())
}
